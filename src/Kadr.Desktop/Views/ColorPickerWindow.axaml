<Window xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:Kadr.Desktop.Controls"
        xmlns:i18n="https://codewf.com"
        xmlns:vm="using:Kadr.Desktop.ViewModels"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kadr.Desktop.Views.ColorPickerWindow"
        x:DataType="vm:ColorPickerViewModel"
        Height="550"
        MinHeight="500"
        MinWidth="520"
        Width="780"
        Classes="modern"
        CanMaximize="False"
        CanMinimize="False"
        CanResize="False"
        FontSize="14"
        ExtendClientAreaTitleBarHeightHint="48"
        ExtendClientAreaToDecorationsHint="True"
        Title="{i18n:I18n Kadr.CustomColorTitle}"
        Topmost="True"
        WindowDecorations="Full"
        WindowDecorationsTheme="{StaticResource KadrColorChrome}"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="NumericUpDown">
            <Setter Property="Height"
                    Value="36" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>
    </Window.Styles>
    <Grid Margin="20,64,20,16"
          RowDefinitions="*,Auto"
          RowSpacing="16">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ColorBody"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="24"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="12">
                <controls:SaturationValueBox x:Name="Spectrum"
                                             Height="320"
                                             Width="320"
                                             Cursor="Cross" />
                <Grid x:Name="RightContent"
                      Grid.Column="1"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="22">
                    <Grid x:Name="ColorTabs"
                          ColumnDefinitions="*,*,*"
                          ColumnSpacing="6">
                        <Button HorizontalAlignment="Stretch"
                                Classes="color-tab"
                                Classes.selected="{Binding IsRgbMode}"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="0"
                                Content="RGB" />
                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Classes="color-tab"
                                Classes.selected="{Binding IsHslMode}"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="1"
                                Content="HSL" />
                        <Button Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Classes="color-tab"
                                Classes.selected="{Binding IsHexMode}"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="2"
                                Content="HEX" />
                    </Grid>
                    <Grid x:Name="RgbFields"
                          Grid.Row="1"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsRgbMode}"
                          ColumnDefinitions="24,*,80"
                          ColumnSpacing="10"
                          RowDefinitions="36,36,36"
                          RowSpacing="12">
                        <TextBlock x:Name="RedLabel"
                                   VerticalAlignment="Center"
                                   Text="R" />
                        <controls:ColorSlider x:Name="RedSlider"
                                              Grid.Column="1"
                                              Height="36"
                                              Cursor="Hand"
                                              Maximum="255"
                                              Value="{Binding Red}" />
                        <NumericUpDown x:Name="RedInput"
                                       Grid.Column="2"
                                       FormatString="0"
                                       Maximum="255"
                                       Minimum="0"
                                       ShowButtonSpinner="False"
                                       Value="{Binding Red}" />
                        <TextBlock x:Name="GreenLabel"
                                   Grid.Row="1"
                                   VerticalAlignment="Center"
                                   Text="G" />
                        <controls:ColorSlider x:Name="GreenSlider"
                                              Grid.Column="1"
                                              Grid.Row="1"
                                              Height="36"
                                              Cursor="Hand"
                                              Maximum="255"
                                              Value="{Binding Green}" />
                        <NumericUpDown x:Name="GreenInput"
                                       Grid.Column="2"
                                       Grid.Row="1"
                                       FormatString="0"
                                       Maximum="255"
                                       Minimum="0"
                                       ShowButtonSpinner="False"
                                       Value="{Binding Green}" />
                        <TextBlock x:Name="BlueLabel"
                                   Grid.Row="2"
                                   VerticalAlignment="Center"
                                   Text="B" />
                        <controls:ColorSlider x:Name="BlueSlider"
                                              Grid.Column="1"
                                              Grid.Row="2"
                                              Height="36"
                                              Cursor="Hand"
                                              Maximum="255"
                                              Value="{Binding Blue}" />
                        <NumericUpDown x:Name="BlueInput"
                                       Grid.Column="2"
                                       Grid.Row="2"
                                       FormatString="0"
                                       Maximum="255"
                                       Minimum="0"
                                       ShowButtonSpinner="False"
                                       Value="{Binding Blue}" />
                    </Grid>
                    <Grid Grid.Row="1"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsHslMode}"
                          ColumnDefinitions="24,*,80"
                          ColumnSpacing="10"
                          RowDefinitions="36,36,36"
                          RowSpacing="12">
                        <TextBlock VerticalAlignment="Center"
                                   Text="H" />
                        <controls:ColorSlider x:Name="HslHueSlider"
                                              Grid.Column="1"
                                              Height="36"
                                              Cursor="Hand"
                                              Maximum="359.999"
                                              Value="{Binding Hue}" />
                        <NumericUpDown Grid.Column="2"
                                       FormatString="0.0"
                                       Maximum="359.999"
                                       Minimum="0"
                                       ShowButtonSpinner="False"
                                       Value="{Binding Hue}" />
                        <TextBlock Grid.Row="1"
                                   VerticalAlignment="Center"
                                   Text="S" />
                        <controls:ColorSlider x:Name="HslSaturationSlider"
                                              Grid.Column="1"
                                              Grid.Row="1"
                                              Height="36"
                                              Cursor="Hand"
                                              Maximum="100"
                                              Value="{Binding HslSaturation}" />
                        <NumericUpDown Grid.Column="2"
                                       Grid.Row="1"
                                       FormatString="0.0"
                                       Maximum="100"
                                       Minimum="0"
                                       ShowButtonSpinner="False"
                                       Value="{Binding HslSaturation}" />
                        <TextBlock Grid.Row="2"
                                   VerticalAlignment="Center"
                                   Text="L" />
                        <controls:ColorSlider x:Name="LightnessSlider"
                                              Grid.Column="1"
                                              Grid.Row="2"
                                              Height="36"
                                              Cursor="Hand"
                                              Maximum="100"
                                              Value="{Binding Lightness}" />
                        <NumericUpDown Grid.Column="2"
                                       Grid.Row="2"
                                       FormatString="0.0"
                                       Maximum="100"
                                       Minimum="0"
                                       ShowButtonSpinner="False"
                                       Value="{Binding Lightness}" />
                    </Grid>
                    <StackPanel x:Name="HexPanel"
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsHexMode}"
                                Spacing="8">
                        <Grid ColumnDefinitions="40,*"
                              ColumnSpacing="10">
                            <TextBlock VerticalAlignment="Center"
                                       Text="HEX" />
                            <TextBox x:Name="HexInput"
                                     Grid.Column="1"
                                     Text="{Binding Hex}" />
                        </Grid>
                        <TextBlock x:Name="HexError"
                                   IsVisible="{Binding HasHexError}"
                                   Foreground="{StaticResource ErrorTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="{i18n:I18n Kadr.InvalidHex}" />
                    </StackPanel>
                    <Grid x:Name="AlphaPanel"
                          Grid.Row="2"
                          ColumnDefinitions="24,*,80"
                          ColumnSpacing="10">
                        <TextBlock x:Name="AlphaLabel"
                                   VerticalAlignment="Center"
                                   Text="A" />
                        <controls:ColorSlider x:Name="AlphaSlider"
                                              Grid.Column="1"
                                              Height="36"
                                              Cursor="Hand"
                                              Maximum="255"
                                              ShowsTransparency="True"
                                              Value="{Binding Alpha}" />
                        <NumericUpDown x:Name="AlphaInput"
                                       Grid.Column="2"
                                       FormatString="0"
                                       Maximum="255"
                                       Minimum="0"
                                       ShowButtonSpinner="False"
                                       Value="{Binding Alpha}" />
                    </Grid>
                </Grid>
                <Grid x:Name="ColorSamples"
                      Grid.Row="1"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="12"
                      RowDefinitions="Auto,34"
                      RowSpacing="6">
                    <TextBlock Classes="muted"
                               Text="{i18n:I18n Kadr.Original}" />
                    <TextBlock Grid.Column="1"
                               Classes="muted"
                               Text="{i18n:I18n Kadr.New}" />
                    <Button Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Padding="0"
                            Classes="subtle"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Command="{Binding RestoreOriginalCommand}">
                        <controls:ColorChip x:Name="OldColor" />
                    </Button>
                    <controls:ColorChip x:Name="NewColor"
                                        Grid.Column="1"
                                        Grid.Row="1" />
                </Grid>
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">
            <Button HorizontalAlignment="Stretch"
                    Command="{Binding CancelCommand}"
                    Content="{i18n:I18n Kadr.Cancel}" />
            <Button Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Classes="primary"
                    Command="{Binding AcceptCommand}"
                    Content="{i18n:I18n Kadr.ChooseColor}" />
        </Grid>
    </Grid>
</Window>
