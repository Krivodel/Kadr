<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <AssemblyName>Kadr</AssemblyName>
    <Version>1.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Krivodeling.Localization.Avalonia" Version="1.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="RapidOcrNet" Version="4.2.0" ExcludeAssets="build;contentFiles" GeneratePathProperty="true" />
    <PackageReference Include="StageKit.Updatum" Version="0.4.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/AppIcon.ico" />
    <AvaloniaResource Include="Assets/AppIcon.png" />
    <EmbeddedResource Include="../../LICENSES/*" LogicalName="Kadr.Licenses.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Kadr.Licenses.LICENSE" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.md" LogicalName="Kadr.Licenses.THIRD-PARTY-NOTICES.md" />
    <EmbeddedResource Include="Resources/paddle-models.json" />
    <EmbeddedResource Include="$(PkgRapidOcrNet)/models/v5/ch_PP-OCRv5_mobile_det.onnx" LogicalName="Kadr.Paddle.det.onnx" />
    <EmbeddedResource Include="$(PkgRapidOcrNet)/models/v5/ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx" LogicalName="Kadr.Paddle.cls.onnx" />
    <EmbeddedResource Include="../../assets/ocr/paddle/*" LogicalName="Kadr.Paddle.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/Updates/public-key.txt" LogicalName="Kadr.UpdatePublicKey" />
    <EmbeddedResource Include="Resources/Localizations/*.json" />
  </ItemGroup>
  <Target Name="BundleWindowsNativeRuntime" BeforeTargets="GenerateSingleFileBundle" DependsOnTargets="PrepareForBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <Error Condition="!Exists('$(CrtDirectory)/vcruntime140.dll') or !Exists('$(CrtDirectory)/msvcp140.dll')" Text="Publish with eng/Publish.ps1 or pass -p:CrtDirectory pointing to the Visual C++ x64 redistributable directory." />
    <ItemGroup>
      <FilesToBundle Remove="@(FilesToBundle)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(FilesToBundle.RelativePath)', '^x86[\\/]')) or '%(FilesToBundle.Extension)' == '.pdb'" />
      <_WindowsCrtFiles Include="$(CrtDirectory)/*.dll" />
      <FilesToBundle Include="@(_WindowsCrtFiles)" RelativePath="%(_WindowsCrtFiles.Filename)%(_WindowsCrtFiles.Extension)" />
    </ItemGroup>
  </Target>
  <Target Name="ExcludeNativeImportLibraries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.lib'" />
    </ItemGroup>
  </Target>
</Project>
